# Copy to .env and fill in. Never commit .env.

# --- Nebius Token Factory (required for any model call) ---
NEBIUS_API_KEY=
# Optional override if the dashboard shows a regional endpoint:
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# --- Nebius AI Cloud (runner as Serverless Job) ---
NEBIUS_PROJECT_ID=

# --- Tavily (World and Voice detectives) ---
TAVILY_API_KEY=

# --- Stripe (TEST MODE keys only: sk_test_..., pk_test_...) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- GitHub (fine-grained token for acme-demo: contents, pull requests, actions: read/write) ---
ACME_GITHUB_TOKEN=
ACME_REPO=Sumit99589/acme-demo

# --- Vercel (token that can read deployments of the Acme project) ---
VERCEL_TOKEN=
VERCEL_ACME_PROJECT=acme-demo
VERCEL_TEAM_ID=

# --- Postgres (Neon in production; leave empty to use the embedded dev Postgres) ---
DATABASE_URL=

# --- S3-compatible object storage (Nebius Object Storage, R2, ...) ---
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Engine ---
# Public URL of the engine (used by the snippet, the simulator and the UI)
WHYDUNIT_ENGINE_URL=http://localhost:8000
# Admin key for privileged engine endpoints (simulator, fixes)
WHYDUNIT_ADMIN_KEY=
# Set to 0 to disable the LLM response cache
WHYDUNIT_LLM_CACHE=1

# --- Provisioning only (lets the agent create the Neon project and the engine Space) ---
NEON_API_KEY=
HF_TOKEN=

# --- Optional notifications (Slack-compatible incoming webhook) ---
WATCHER_WEBHOOK_URL=
